{
 "cases": [
  {"name": "hidden folder block never searches",
   "kind": "script",
   "settings": {},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {"C:\\photos\\trip": {"previous": "C:\\photos\\a", "next": "C:\\photos\\c"}},
   "steps": [
    {"op": "set_folder", "folder": "C:\\photos\\trip"},
    {"op": "refresh"}
   ]},

  {"name": "placeholder, then the siblings found by the finder",
   "kind": "script",
   "settings": {"show_folder_info": true},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {"C:\\photos\\trip": {"previous": "C:\\photos\\a", "next": "C:\\photos\\c"}},
   "steps": [
    {"op": "set_folder", "folder": "C:\\photos\\trip"},
    {"op": "refresh"}
   ]},

  {"name": "no sibling found: the folder line alone",
   "kind": "script",
   "settings": {"show_folder_info": true},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {"C:\\photos\\trip": {"previous": null, "next": null}},
   "steps": [
    {"op": "set_folder", "folder": "C:\\photos\\trip"}
   ]},

  {"name": "IOException from the finder falls back to the folder alone",
   "kind": "script",
   "settings": {"show_folder_info": true},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {"C:\\photos\\trip": {"fault": "IOException"}},
   "steps": [
    {"op": "set_folder", "folder": "C:\\photos\\trip"}
   ]},

  {"name": "UnauthorizedAccessException from the finder falls back to the folder alone",
   "kind": "script",
   "settings": {"show_folder_info": true},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {"C:\\photos\\trip": {"fault": "UnauthorizedAccessException"}},
   "steps": [
    {"op": "set_folder", "folder": "C:\\photos\\trip"}
   ]},

  {"name": "a blank NextFolder shortcut hides only the next part",
   "kind": "script",
   "settings": {"show_folder_info": true, "next_folder": "   "},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {"C:\\photos\\trip": {"previous": "C:\\photos\\a", "next": "C:\\photos\\c"}},
   "steps": [
    {"op": "set_folder", "folder": "C:\\photos\\trip"}
   ]},

  {"name": "shortcut names are trimmed before they are shown",
   "kind": "script",
   "settings": {"show_folder_info": true, "previous_folder": " PageUp "},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {"C:\\photos\\trip": {"previous": "C:\\photos\\a", "next": "C:\\photos\\c"}},
   "steps": [
    {"op": "set_folder", "folder": "C:\\photos\\trip"}
   ]},

  {"name": "a whitespace-only folder is no folder",
   "kind": "script",
   "settings": {"show_folder_info": true},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {},
   "steps": [
    {"op": "set_folder", "folder": "   "},
    {"op": "refresh"}
   ]},

  {"name": "one trailing separator is removed before the name is taken",
   "kind": "script",
   "settings": {"show_folder_info": true},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {"C:\\photos\\trip\\": {"previous": null, "next": null}},
   "steps": [
    {"op": "set_folder", "folder": "C:\\photos\\trip\\"}
   ]},

  {"name": "a second trailing separator leaves no name, so the full folder is shown",
   "kind": "script",
   "settings": {"show_folder_info": true},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {"C:\\photos\\\\": {"previous": null, "next": null}},
   "steps": [
    {"op": "set_folder", "folder": "C:\\photos\\\\"}
   ]},

  {"name": "a drive root keeps its name",
   "kind": "script",
   "settings": {"show_folder_info": true},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {"C:\\": {"previous": null, "next": null}},
   "steps": [
    {"op": "set_folder", "folder": "C:\\"}
   ]},

  {"name": "forward slashes are separators too, one trailing separator is removed",
   "kind": "script",
   "settings": {"show_folder_info": true},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {"/home/user/pics/": {"previous": null, "next": null}},
   "steps": [
    {"op": "set_folder", "folder": "/home/user/pics/"}
   ]},

  {"name": "hiding and showing again reuses the siblings already found",
   "kind": "script",
   "settings": {"show_folder_info": true},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {"C:\\photos\\trip": {"previous": "C:\\photos\\a", "next": "C:\\photos\\c"}},
   "steps": [
    {"op": "set_folder", "folder": "C:\\photos\\trip"},
    {"op": "set_settings", "show_folder_info": false},
    {"op": "refresh"},
    {"op": "set_settings", "show_folder_info": true},
    {"op": "refresh"}
   ]},

  {"name": "a different folder drops the old siblings and searches again",
   "kind": "script",
   "settings": {"show_folder_info": true},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {
     "C:\\photos\\trip": {"previous": "C:\\photos\\a", "next": "C:\\photos\\c"},
     "D:\\other": {"previous": null, "next": null}},
   "steps": [
    {"op": "set_folder", "folder": "C:\\photos\\trip"},
    {"op": "set_folder", "folder": "D:\\other"}
   ]},

  {"name": "refreshing the same folder does not search again",
   "kind": "script",
   "settings": {"show_folder_info": true},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {"C:\\photos\\trip": {"previous": "C:\\photos\\a", "next": "C:\\photos\\c"}},
   "steps": [
    {"op": "set_folder", "folder": "C:\\photos\\trip"},
    {"op": "refresh"},
    {"op": "set_settings", "info_overlay_font_size": 16},
    {"op": "refresh"}
   ]},

  {"name": "the master switch hides both blocks and turning it on searches again",
   "kind": "script",
   "settings": {"show_folder_info": true, "show_info_overlay": false},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {"C:\\photos\\trip": {"previous": "C:\\photos\\a", "next": "C:\\photos\\c"}},
   "steps": [
    {"op": "set_folder", "folder": "C:\\photos\\trip"},
    {"op": "set_settings", "show_info_overlay": true},
    {"op": "refresh"}
   ]},

  {"name": "zoom HUD follows the setting and the image, read live",
   "kind": "script",
   "settings": {"show_zoom_indicator": true},
   "view": {"has_image": true, "zoom_percent": 150},
   "finder": {},
   "steps": [
    {"op": "refresh"},
    {"op": "set_view", "has_image": false, "zoom_percent": 150},
    {"op": "set_view", "has_image": true, "zoom_percent": 37},
    {"op": "refresh"}
   ]},

  {"name": "zoom text is a plain integer, negative and large values included",
   "kind": "script",
   "settings": {"show_zoom_indicator": true},
   "view": {"has_image": true, "zoom_percent": -5},
   "finder": {},
   "steps": [
    {"op": "refresh"},
    {"op": "set_view", "has_image": true, "zoom_percent": 400},
    {"op": "refresh"}
   ]},

  {"name": "zoom HUD off stays off even with an image",
   "kind": "script",
   "settings": {"show_zoom_indicator": false},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {},
   "steps": [
    {"op": "refresh"}
   ]},

  {"name": "font size follows the setting and the EXIF line is one point smaller",
   "kind": "script",
   "settings": {},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {},
   "steps": [
    {"op": "refresh"},
    {"op": "set_settings", "info_overlay_font_size": 8},
    {"op": "set_settings", "info_overlay_font_size": 24},
    {"op": "refresh"}
   ]},

  {"name": "file info block follows its own switch and the master switch",
   "kind": "script",
   "settings": {"show_file_info": false},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {},
   "steps": [
    {"op": "refresh"},
    {"op": "set_settings", "show_file_info": true},
    {"op": "set_settings", "show_info_overlay": false},
    {"op": "refresh"}
   ]},

  {"name": "raise order: six notifications, then FolderInfoText (placeholder, then the answer)",
   "kind": "script",
   "settings": {"show_folder_info": true},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {"C:\\photos\\trip": {"previous": "C:\\photos\\a", "next": "C:\\photos\\c"}},
   "steps": [
    {"op": "set_folder", "folder": "C:\\photos\\trip"}
   ]},

  {"name": "raise order while hidden: six notifications, FolderInfoText only when it changes",
   "kind": "script",
   "settings": {"show_folder_info": false},
   "view": {"has_image": true, "zoom_percent": 100},
   "finder": {},
   "steps": [
    {"op": "set_folder", "folder": "C:\\photos\\trip"},
    {"op": "refresh"}
   ]}
 ]
}
