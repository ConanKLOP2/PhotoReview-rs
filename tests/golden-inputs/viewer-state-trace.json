    {"op": "set_dpi_scale", "value": 0.24},
    {"op": "query"},
    {"op": "set_dpi_scale", "value": "NaN"},
    {"op": "query"},
    {"op": "set_dpi_scale", "value": 16.0},
    {"op": "query"}
   ]},
  {"name": "display zoom percent rounds half to even (C# Math.Round)",
   "steps": [
    {"op": "set_zoom", "value": 0.125},
    {"op": "query"},
    {"op": "set_zoom", "value": 0.375},
    {"op": "query"},
    {"op": "set_zoom", "value": 0.625},
    {"op": "query"},
    {"op": "set_zoom", "value": 1.505},
    {"op": "query"}
   ]},
  {"name": "raw viewport limits drive the fit zoom and the fit HUD percent",
   "steps": [
    {"op": "set_source_size", "width": 1000, "height": 1000, "new_image": true},
