    {"op": "set_max_image_height", "value": 250},
    {"op": "query"},
    {"op": "zoom_to_fit_height"},
    {"op": "query"}
   ]},
  {"name": "fullscreen toggles and exit is idempotent",
   "steps": [
    {"op": "toggle_fullscreen"},
    {"op": "toggle_fullscreen"},
    {"op": "toggle_fullscreen"},
    {"op": "exit_fullscreen"},
    {"op": "exit_fullscreen"},
    {"op": "query"}
   ]},
  {"name": "scaling quality and force high quality report the effective quality",
   "steps": [
    {"op": "set_scaling_quality", "value": "Linear"},
    {"op": "set_force_high_quality", "value": true},
    {"op": "set_force_high_quality", "value": true},
    {"op": "set_scaling_quality", "value": "HighQuality"},
    {"op": "set_force_high_quality", "value": false},
    {"op": "query"}
