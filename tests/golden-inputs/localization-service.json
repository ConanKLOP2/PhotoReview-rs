    { "id": "reload-no-user-files-vi", "kind": "reload_problems", "language": "vi", "user_files": {} },
    {
      "id": "reload-valid-user-file-replaces-title",
      "kind": "reload_problems",
      "language": "vi",
      "user_files": {
        "vi.json": "{ \"_meta\": { \"code\": \"vi\" }, \"app.title\": \"Duyệt ảnh\" }"
      }
    },
    {
      "id": "reload-broken-user-file-is-skipped-with-problem",
