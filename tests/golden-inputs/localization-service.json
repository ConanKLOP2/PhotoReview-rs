      "start_culture": "fr",
      "mode": "None",
      "load_language": "en",
      "language": "community"
    },
    {
      "id": "apply-not-a-culture-name-keeps-current-culture",
      "kind": "apply_culture",
      "start_culture": "fr",
      "mode": "None",
      "load_language": "en",
      "language": "not a culture!"
    },
    {
      "id": "apply-blank-empty-is-recorded-auto",
      "kind": "apply_culture",
      "start_culture": "fr",
      "mode": "None",
      "load_language": "en",
      "language": ""
    },
    {
      "id": "apply-blank-spaces-is-recorded-auto",
      "kind": "apply_culture",
      "start_culture": "fr",
      "mode": "None",
      "load_language": "en",
      "language": "   "
    },
    {
