      "key": "Mouse",
      "title": "Mouse & zoom",
      "items": [
        {
          "class": "Button",
          "id": 3001,
          "text": "Zoom",
          "style": 1342177287,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3002,
          "text": "Click zoom level",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Edit",
          "id": 3003,
          "text": "",
          "style": 1342242944,
          "ex_style": 512
        },
        {
          "class": "Static",
          "id": 3004,
          "text": "The zoom level used by click-to-zoom, the zoom shortcut and the right-click Zoom menu. It applies even when click-to-zoom is off.",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 3005,
          "text": "Click to zoom",
          "style": 1342251011,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3006,
          "text": "Arrow key step (zoomed image)",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Edit",
          "id": 3007,
          "text": "",
          "style": 1342242944,
          "ex_style": 512
        },
        {
          "class": "Static",
          "id": 3008,
          "text": "How far one arrow press moves a zoomed image, in percent of the SHORTER side of the view; the same number of pixels horizontally and vertically (default 10).",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3009,
          "text": "Keyboard zoom anchors at",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "ComboBox",
          "id": 3010,
          "text": "",
          "style": 1344340483,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3011,
          "text": "Where +/- keyboard zoom, 100 % and the click-zoom shortcut keep the image in place. Mouse wheel and click-to-zoom always anchor at the cursor.",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3012,
          "text": "Zoom shortcuts",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3013,
          "text": "",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3014,
          "text": "Read-only: change these keys on the Shortcuts page.",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3015,
          "text": "Fit width shows 1",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "ComboBox",
          "id": 3016,
          "text": "",
          "style": 1344340483,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3017,
          "text": "Which part of the image stays at the centre of the view after Fit width: Centre (default), Top third (portraits usually have the face there) or Bottom third. Also used by the initial view when it is Fit width.",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 3018,
          "text": "Keep zoom level when changing photo",
          "style": 1342251011,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3019,
          "text": "On: the view (Fit or a zoom level) stays the same when you move to the next photo, instead of resetting to the initial view. Default off.",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3020,
          "text": "Keyboard zoom step (%)",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Edit",
          "id": 3021,
          "text": "",
          "style": 1342242944,
          "ex_style": 512
        },
        {
          "class": "Static",
          "id": 3022,
          "text": "How far +/- keyboard zoom and mouse-wheel zoom move on each press, in percent of original size (5-100, default 10).",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3023,
          "text": "Fit width shows 2",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "ComboBox",
          "id": 3024,
          "text": "",
          "style": 1344340483,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3025,
          "text": "Which part of the image stays at the centre of the view after the second Fit width command (shortcut, Zoom menu item or middle click): Centre, Top third or Bottom third (default). It does not affect the initial view.",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3026,
          "text": "Middle click action",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "ComboBox",
          "id": 3027,
          "text": "",
          "style": 1344340483,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3028,
          "text": "What clicking the middle mouse button (wheel press) over the image does. Default: Fullsize (100 %). Fullsize and Click-to-zoom follow \"Keyboard zoom anchors at\".",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 3029,
          "text": "Click-zoom key returns to Fit when already at the click zoom level",
          "style": 1342251011,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3030,
          "text": "Off (default): the click-zoom key always goes to the click zoom level and does nothing when the image is already there; use the Fit key to go back. On: pressing it at the click zoom level goes back to Fit (like a mouse click).",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 3031,
          "text": "Mouse && zoom",
          "style": 1342177287,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3032,
          "text": "Mouse wheel",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "ComboBox",
          "id": 3033,
          "text": "",
          "style": 1344340483,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3034,
          "text": "Ctrl+wheel always zooms.",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 3035,
          "text": "Kinetic panning",
          "style": 1342251011,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3036,
          "text": "Glide smoothing",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "ComboBox",
          "id": 3037,
          "text": "",
          "style": 1344340483,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3038,
          "text": "Moves the glide in step with your monitor's refresh rate. Turn off to compare.",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 3039,
          "text": "Arrow key at the edge of a zoomed image goes to the next/previous photo",
          "style": 1342251011,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3040,
          "text": "Off (default): arrow keys only move around a zoomed image; go back to Fit to change photo. On: pressing an arrow key again at the edge changes photo.",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3041,
          "text": "Transition when changing photo",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "ComboBox",
          "id": 3042,
          "text": "",
          "style": 1344340483,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3043,
          "text": "Only when navigating to a different photo; the thumbnail-to-full-quality upgrade of the same photo always stays instant.",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3044,
          "text": "Fade duration (ms)",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Edit",
          "id": 3045,
          "text": "",
          "style": 1342242944,
          "ex_style": 512
        },
        {
          "class": "Button",
          "id": 3046,
          "text": "Touchpad two-finger swipe: pan a zoomed photo, change photo at Fit (up/down)",
          "style": 1342251011,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3047,
          "text": "Pinch still zooms and an ordinary mouse wheel keeps the wheel setting above. A sideways swipe at Fit is ignored. Some smooth-scrolling mice look like a touchpad; turn this off if your mouse wheel stops zooming.",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3048,
          "text": "Touchpad swipe per photo",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Edit",
          "id": 3049,
          "text": "",
          "style": 1342242944,
          "ex_style": 512
        },
        {
          "class": "Static",
          "id": 3050,
          "text": "Wheel units (120 = one mouse-wheel notch). The default 200 is roughly 1.5-2 cm on a typical precision touchpad; the exact distance depends on the touchpad driver. Larger = a longer swipe per photo. The first photo changes after half of it.",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 3051,
          "text": "Right-click menu",
          "style": 1342177287,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 3052,
          "text": "Tick the items to show in the right-click menu; untick to hide one. Keyboard shortcuts keep working for hidden items. Separator lines disappear together with an empty group. Everything is saved with the other settings and travels with Export / Import.",
          "style": 1342177408,
          "ex_style": 0
        },
