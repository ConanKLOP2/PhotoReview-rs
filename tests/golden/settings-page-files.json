      "key": "Files",
      "title": "Files & safety",
      "items": [
        {
          "class": "Button",
          "id": 6001,
          "text": "Duplicate comparison",
          "style": 1342177287,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 6002,
          "text": "Compare hash (reads the files to confirm the bytes are identical)",
          "style": 1342251011,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 6003,
          "text": "Compare file size",
          "style": 1342251011,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 6004,
          "text": "Camera RAW",
          "style": 1342177287,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 6005,
          "text": "Enable Camera RAW support (.cr2, .cr3, .nef, .arw, .dng, .raf, .orf, .rw2)",
          "style": 1342251011,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 6006,
          "text": "Loads embedded JPEG previews from camera RAW files for fast viewing and navigation.",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 6007,
          "text": "RAW full decode (demosaic)",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "ComboBox",
          "id": 6008,
          "text": "",
          "style": 1344340483,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 6009,
          "text": "Never: always shows the fast embedded preview and never decodes the sensor data, even when zoomed in. On zoom: decodes the sensor data at full resolution when you zoom in beyond the preview.",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 6010,
          "text": "JPEG+RAW pairs",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "ComboBox",
          "id": 6011,
          "text": "",
          "style": 1344340483,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 6012,
          "text": "How pairs with matching names in the same folder are grouped.",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 6013,
          "text": "In the stacked modes only one file of a pair is shown. To see the other one, assign a key to \"Switch JPEG / RAW member\" under Shortcuts (no key is assigned by default), or open Compare.",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 6014,
          "text": "WebP and HEIC/HEIF",
          "style": 1342177287,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 6015,
          "text": "Enable WebP and HEIC/HEIF images (.webp, .heic, .heif) through the Windows codecs",
          "style": 1342251011,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 6016,
          "text": "Uses the codecs Windows provides; nothing is bundled with PhotoReview. An animated WebP shows its first frame only.",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 6017,
          "text": "",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 6018,
          "text": "Allow permanent delete on drives without a Recycle Bin",
          "style": 1342251011,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 6019,
          "text": "Off by default: Delete is refused on removable, network and unknown drives because they have no Recycle Bin. When on, Delete removes the file permanently after a confirmation. Deleted files cannot be restored, not even with Undo.",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 6020,
          "text": "Confirm before Delete/Recycle",
          "style": 1342251011,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 6021,
          "text": "Off by default. When on, a Yes/No prompt is shown every time before a photo is sent to the Recycle Bin (on top of the permanent-delete warning above, which is unaffected).",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 6022,
          "text": "External editor",
          "style": 1342177287,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 6023,
          "text": "Editor executable path",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Edit",
          "id": 6024,
          "text": "",
          "style": 1342242944,
          "ex_style": 512
        },
        {
          "class": "Button",
          "id": 6025,
          "text": "Browse…",
          "style": 1342242816,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 6026,
          "text": "Right-click a photo > Open in External Editor launches this executable with the photo's path as argument. Leave empty to hide that menu item.",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 6027,
          "text": "Operation journal",
          "style": 1342177287,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 6028,
          "text": "Operation journal durability",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 6029,
          "text": "Fast (default)",
          "style": 1342382089,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 6030,
          "text": "Power-loss safe",
          "style": 1342185481,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 6031,
          "text": "Records reach the OS cache before each file operation. Survives an app crash; after a power loss or OS crash the last few records may be lost, so Undo/Recovery may not know about a very recent move.",
          "style": 1342308480,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 6032,
          "text": "Every record is forced to disk before the file operation starts. Safest, but about 4x slower per record (still off the UI thread, so the app stays responsive).",
          "style": 1342177408,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 6033,
          "text": "Actions",
          "style": 1342177287,
          "ex_style": 0
        },
        {
          "class": "Button",
          "id": 6034,
          "text": "Reuse the last folder",
          "style": 1342251011,
          "ex_style": 0
        },
        {
          "class": "Static",
          "id": 6035,
          "text": "Shift always asks.",
          "style": 1342177408,
          "ex_style": 0
        }
      ],
