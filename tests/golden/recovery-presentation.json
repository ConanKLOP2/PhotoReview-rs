    {
      "name": "explain-text-all",
      "fn": "explain_text_all",
      "input": {},
      "output": [
        {
          "in": "CanRetry",
          "out": "The source is unchanged and nothing exists at the destination, so the operation can be retried safely."
        },
        {
          "in": "AlreadyDone",
          "out": "The file is already at the destination and the source is gone (for Copy: both match). The operation actually finished."
        },
        {
          "in": "Conflict",
          "out": "Both the source and the destination exist. Compare the two files before deciding."
        },
        {
          "in": "SourceChanged",
          "out": "The source was modified since the operation was recorded; retry is refused to protect your data."
        },
        {
          "in": "DestinationChanged",
          "out": "The source is gone and the destination has a different size than recorded; it may be an incomplete copy."
        },
        {
          "in": "Lost",
          "out": "Neither the source nor the destination exists. The file may have been deleted or moved elsewhere."
        },
        {
          "in": "Unknown",
          "out": "The files could not be inspected (access denied or unreadable), or the entry has no destination."
        },
        {
          "in": "RecycleUnverifiable",
          "out": "The source is gone; it was presumably sent to the Recycle Bin, but this cannot be verified here."
        },
        {
          "in": "NotRecycled",
          "out": "The source still exists, so the file was not sent to the Recycle Bin."
        },
        {
          "in": "PermanentlyDeleted",
          "out": "The file was deleted permanently because its drive has no Recycle Bin. It cannot be restored from Photo Review."
        },
        {
          "in": "PartiallyPermanentlyDeleted",
          "out": "Some files of this capture were deleted permanently because their drive has no Recycle Bin and cannot be restored from Photo Review. The other files were moved to the Recycle Bin."
        }
      ]
    },
