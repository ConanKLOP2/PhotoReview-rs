<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Golden generator: runs the C# PhotoReview code (built from the baseline commit by tools/oracle.ps1, outside any
    git repo) and writes tests/golden/**. It only reads the C# repo through `git archive`; it never changes it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>oracle-cs</AssemblyName>
    <RootNamespace>OracleCs</RootNamespace>
    <!-- W4-02b/W4-11c: fixture generation uses System.Windows.Media.Imaging (the WPF JPEG/PNG encoders). -->
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Set by tools/oracle.ps1: folder holding the baseline build of PhotoReview.Core.dll. -->
    <CSharpCoreDir Condition="'$(CSharpCoreDir)' == ''">..\..\work\oracle\core</CSharpCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PhotoReview.Core">
      <HintPath>$(CSharpCoreDir)\PhotoReview.Core.dll</HintPath>
    </Reference>
    <Reference Include="PhotoReview.Imaging">
      <HintPath>$(CSharpCoreDir)\PhotoReview.Imaging.dll</HintPath>
    </Reference>
    <Reference Include="PhotoReview.PerfAnalysis">
      <HintPath>$(CSharpCoreDir)\PhotoReview.PerfAnalysis.dll</HintPath>
    </Reference>
    <Reference Include="PhotoReview.Localization.Generator">
      <HintPath>$(CSharpCoreDir)\PhotoReview.Localization.Generator.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- UseWPF removes these from the SDK implicit usings; the earlier commands rely on them. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Threading" />
  </ItemGroup>

  <ItemGroup>
    <!-- W2-04: the real Roslyn TrGenerator is run over in-memory catalogs. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

</Project>
